# Copy to Scripts/.env and fill in. Scripts/.env is gitignored.
#
# These are for the Phase 0 push spike only. The production path reads the same values
# from Supabase Edge Function secrets, never from here.

# Absolute path to the APNs auth key. KEEP IT OUTSIDE THIS REPO.
# It downloads exactly once from developer.apple.com; if you lose it you must revoke the
# key and create a new one.
APNS_P8_PATH=/secure/path/outside/this/repo/AuthKey_ABC1234567.p8

# The 10 character key id, which is also in the .p8 filename.
APNS_KEY_ID=ABC1234567

# Your 10 character Apple Developer Team ID.
APNS_TEAM_ID=DEF7654321

# The MAIN app bundle id, not the widget's. Sending the widget's id returns TopicDisallowed.
APNS_BUNDLE_ID=com.huydao.moodcats

# sandbox | production
# Builds run from Xcode are Debug and get sandbox tokens. TestFlight and App Store builds
# are Release and get production tokens. Sending a sandbox token to the production host
# returns 400 BadDeviceToken and the feature dies silently.
APNS_ENV=sandbox
